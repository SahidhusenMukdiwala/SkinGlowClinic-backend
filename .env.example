# Server Configuration
PORT=5000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_USER=newuser
DB_PASS=sahid
DB_NAME=skinglow

# JWT Authentication
JWT_SECRET=skinglow_jwt_super_secret_key_change_in_production_2026
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=skinglow_refresh_super_secret_key_change_in_production_2026
